# ================================================================
# VERDE Environment Configuration
# ================================================================

# Application
APP_NAME=VERDE
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
SECRET_KEY=verde_super_secret_key_change_in_production_32bytes!

# Database
# Default: SQLite async database
DATABASE_URL=sqlite+aiosqlite:///./verde.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://verde_user:password@localhost:5432/verde_db

# BRAIN Client Settings
BRAIN_API_BASE_URL=https://api.worldquantbrain.com
BRAIN_DEBUG=false
BRAIN_TIMEOUT=60
BRAIN_MAX_RETRIES=3

# Research & Validation Thresholds (Project Defaults)
MIN_SHARPE=1.25
MIN_FITNESS=1.00
MAX_TURNOVER=0.70
MIN_MARGIN_BPS=4.00

# Priority Allocation Ratios
PROVEN_RATIO=0.70
EXPLORED_RATIO=0.20
NOVEL_RATIO=0.10

# Preflight Engine Thresholds
PREFLIGHT_MIN_VALID_RATIO=0.80
PREFLIGHT_MIN_UNIQUE_VALUES=10
PREFLIGHT_MIN_CROSS_SECTIONAL_STD=0.0001
PREFLIGHT_CONSTANT_TOLERANCE=0.95

# AI Integration (Optional)
AI_ENABLED=false
AI_PROVIDER=none
AI_ENCRYPTION_KEY=verde_master_secret_encryption_key_32_bytes!!
